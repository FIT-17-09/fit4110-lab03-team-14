    {
      "name": "05_Consumer_side_Smoke",
      "item": [
        {
          "name": "Consumer smoke - AI Vision calls IoT Ingestion mock to post a reading",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{iotIngestionMockUrl}}/readings",
              "host": [
                "{{iotIngestionMockUrl}}"
              ],
              "path": [
                "readings"
              ]
            },
            "description": "Consumer smoke test: AI Vision calls the IoT Ingestion mock server to propagate a reading/alert.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"AI-VISION-01\",\n  \"metric\": \"temperature\",\n  \"value\": 35.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-26T12:00:00+07:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "response": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Consumer receives success from provider mock', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "pm.test('Consumer can read reading fields', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('reading_id');",
                  "  pm.expect(json).to.have.property('accepted', true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
